{
  "name": "openskylight",
  "version": "0.8.0",
  "description": "OpenSkyLight — an open-source standalone family calendar display (Skylight Calendar clone)",
  "main": "./out/main/index.js",
  "author": "Tyler",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:windowed": "electron-vite dev -- --windowed",
    "dev:companion": "vite --config companion.vite.config.ts",
    "dev:web": "concurrently -k -n api,ui -c yellow,cyan \"npm run start:web\" \"npm run dev:web:ui\"",
    "dev:web:ui": "vite --config web.vite.config.ts --host 0.0.0.0 --port 5173",
    "start:web": "npm run build:web && npm run build:companion && npm rebuild better-sqlite3 && tsx --tsconfig tsconfig.node.json src/web/server.ts",
    "build": "electron-vite build && npm run build:companion",
    "build:companion": "vite build --config companion.vite.config.ts",
    "build:web": "vite build --config web.vite.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@googleapis/calendar": "^15.0.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.8.0",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^10.7.0",
    "ical.js": "^2.2.1",
    "luxon": "^3.5.0",
    "mpegts.js": "^1.8.0",
    "react-qr-barcode-scanner": "^2.1.25",
    "rrule": "^2.8.1",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.66.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "playwright-core": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-simple-keyboard": "^3.8.27",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "zustand": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "ffmpeg-static@5.3.0": true,
    "fsevents@2.3.3": true,
    "electron@41.10.2": true,
    "better-sqlite3@12.11.1": true
  }
}
